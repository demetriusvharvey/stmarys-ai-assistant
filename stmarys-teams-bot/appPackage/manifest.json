{
    "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.26/MicrosoftTeams.schema.json",
    "manifestVersion": "1.26",
    "version": "1.0.0",
    "id": "${{TEAMS_APP_ID}}",
    "developer": {
        "name": "St. Mary's Home",
        "websiteUrl": "https://saintmaryshome.org",
        "privacyUrl": "https://saintmaryshome.org/privacy",
        "termsOfUseUrl": "https://saintmaryshome.org/terms"
    },
    "icons": {
        "color": "color.png",
        "outline": "outline.png"
    },
    "name": {
        "short": "St. Mary's AI${{APP_NAME_SUFFIX}}",
        "full": "St. Mary's Home AI Knowledge Assistant"
    },
    "description": {
        "short": "Ask questions about policies, IT, HR, and operations.",
        "full": "St. Mary's AI Workforce gives staff instant answers about internal policies, procedures, IT troubleshooting, HR processes, compliance, scheduling, and more — directly inside Microsoft Teams."
    },
    "accentColor": "#0f766e",
    "supportsChannelFeatures": "tier1",
    "bots": [
        {
            "botId": "${{BOT_ID}}",
            "scopes": [
                "team",
                "groupChat",
                "personal"
            ],
            "supportsFiles": false,
            "isNotificationOnly": false,
            "commandLists": [
                {
                    "scopes": ["personal", "team", "groupChat"],
                    "commands": [
                        {
                            "title": "What is the attendance policy?",
                            "description": "Look up the attendance or call-out policy"
                        },
                        {
                            "title": "Submit an IT ticket",
                            "description": "Report a technical issue to IT Support"
                        },
                        {
                            "title": "How do I request PTO?",
                            "description": "Get help with PTO, Paylocity, or payroll questions"
                        },
                        {
                            "title": "What can you do?",
                            "description": "See all available agents and capabilities"
                        }
                    ]
                }
            ]
        }
    ],
    "composeExtensions": [],
    "configurableTabs": [],
    "staticTabs": [],
    "permissions": [
        "identity",
        "messageTeamMembers"
    ],
    "validDomains": [
        "${{BOT_DOMAIN}}"
    ]
}
